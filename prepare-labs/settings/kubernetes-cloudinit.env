# Same lab as kubernetes.env, but faster to deploy (AWS only for now).
# The node-local steps (CLOUDINIT_STEPS) run on each node at first boot,
# as cloud-init user data, instead of one pssh call per command.
# The steps in STEPS still run with pssh, because they need the other
# nodes of the cluster.

CLUSTERSIZE=4

CLUSTERPREFIX=node

USER_LOGIN=k8s
USER_PASSWORD=training

# Create and destroy up to 100 VMs at a time (Terraform's default is 10).
TERRAFORM_PARALLELISM=100

CLOUDINIT_STEPS="
  standardize
  tools
  docker
  usersetup
  webssh
  tailhist
  kubepkgs
  kubetools
"

STEPS="
  cloudinit
  terraform
  nodesetup
  clusterize
  userkeys
  kubeadm
  kubetest
"
